export SETUP_DIRENV_PLAIN=from-envrc

# Multi-line, and it has to be an export: direnv's dotenv parser rejects a value that
# spans lines, so .env cannot carry this. The second line is what a plain "key=value"
# append to $GITHUB_ENV would turn into a variable of its own.
export SETUP_DIRENV_MULTI="first line
SETUP_DIRENV_FORGED=nope
last line"

dotenv_if_exists .env
